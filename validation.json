  },
  "server_command": "llama-server -m MacJev-322M-4K-Laya-F16.gguf --host 127.0.0.1 --port 8080 --embeddings --pooling none -c 4096 -b 4096 -ub 4096 -np 1 -fa on",
  "server_flags_rationale": {
    "--embeddings --pooling none": "per-token hidden states (after final_norm), no pooling, no normalization",
    "-c 4096 -b 4096 -ub 4096": "bidirectional encoder: the whole <=4096-token sequence must be one ubatch (4097 is rejected with HTTP 500)",
    "-np 1": "single slot, n_ctx_slot = 4096",
    "-fa on": "Metal flash attention keeps attention probabilities in fp32 (the non-FA Metal path rounds Q, K, softmax(P) and V to fp16 inside mul_mm); lower hidden-state error than -fa off on the parity rows (rel_fro 0.0082 vs 0.0088, p99 0.017 vs 0.022) and on the fixed-24 rows (0.0020 vs 0.0032). Chosen before the full validation runs.",
    "host": "bind 127.0.0.1 only"
  },
  "known_deviation": {
    "cause": "ggml's GEGLU uses the tanh approximation of GELU (Metal: tanh formula; CPU: fp16 lookup table). ModernBERT/mmBERT uses exact erf GELU. The modern-bert hidden_activation key at this build cannot select an erf GEGLU.",
    "evidence": "PyTorch FP32 with only GELU switched to tanh reproduces the drift: on the 472 calibration rows with reference top-2 margin < 1e-4, exact GELU gives 0 top-1 changes and tanh GELU gives 18; on the 24 fixed checks the GELU swap alone moves probabilities by up to 0.0022.",
    "metal_f32_equals_f16": "Metal's F32 matmul path rounds inputs to fp16; F32 and F16 GGUFs produced bit-identical logits on all 9000 rows, so only F16 is shipped.",
    "ruled_out": [
      "sliding window (+-64 symmetric, matches ModernBERT)",
      "final norm",
      "rope theta 160000 for both layer kinds",
      "norm eps 1e-5",
      "tokenization (runtime sends HF token ids)"
    ]
  },
